# Backend. Defaults to https://paintry.onrender.com when unset.
# For a local server use your machine's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=https://paintry.onrender.com

# Perceptron Mk1.5 key for receipt OCR (https://docs.perceptron.inc).
# Read only by the server route src/app/receipt-ocr+api.ts, never bundled into the app.
PERCEPTRON_API_KEY=

# Supabase auth (email code sign-in). Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
